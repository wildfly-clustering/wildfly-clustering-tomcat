<arquillian xmlns="http://jboss.org/schema/arquillian" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">
	<extension qualifier="OCI">
		<property name="oci:image">${tomcat.container.image}</property>
		<property name="oci:network-mode">host</property>
		<property name="oci:start-message-pattern">.*\QServer startup in \E.*</property>
		<property name="ref:HTTP_PORT">bindHttpPort</property>
		<property name="ref:JMX_PORT">jmxPort</property>
		<property name="ref:JVM_ROUTE"/>
		<property name="env:JAVA_OPTS">${tomcat.container.parameters}</property>
		<property name="file:${project.basedir}/../../catalina/src/test/resources">/usr/local/tomcat</property>
		<property name="file:${project.build.directory}/dependency">/usr/local/tomcat/lib</property>
	</extension>
	<group qualifier="tomcat" default="true">
		<container qualifier="server-1" mode="manual">
			<configuration>
				<property name="bindHttpPort">8080</property>
				<property name="jmxPort">8089</property>
			</configuration>
		</container>
		<container qualifier="server-2" mode="manual">
			<configuration>
				<property name="bindHttpPort">8180</property>
				<property name="jmxPort">8189</property>
			</configuration>
		</container>
		<container qualifier="server-3" mode="manual">
			<configuration>
				<property name="bindHttpPort">8280</property>
				<property name="jmxPort">8289</property>
			</configuration>
		</container>
	</group>
</arquillian>

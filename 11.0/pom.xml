<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.wildfly.clustering.tomcat</groupId>
		<artifactId>wildfly-clustering-tomcat</artifactId>
		<version>32.0.0.Beta1-SNAPSHOT</version>
	</parent>

	<artifactId>wildfly-clustering-tomcat-11.0</artifactId>
	<packaging>pom</packaging>

	<name>${project.tomcat}: Modules</name>

	<properties>
		<project.tomcat>${project.repository.name} 11.0</project.tomcat>

		<tomcat.container.image>tomcat:11.0</tomcat.container.image>
		<tomcat.container.parameters>${java.runtime.parameters} -Dhttp.port=$HTTP_PORT -Djvm.route=$JVM_ROUTE -Dcom.sun.management.jmxremote.port=$JMX_PORT -Dcom.sun.management.jmxremote.ssl=false -Dcom.sun.management.jmxremote.authenticate=false</tomcat.container.parameters>
	</properties>

	<modules>
		<module>catalina</module>
		<module>infinispan</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.apache.tomcat</groupId>
				<artifactId>tomcat-catalina</artifactId>
				<version>11.0.27</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
